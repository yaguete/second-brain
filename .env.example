# Generate with: openssl rand -base64 32
BRIDGE_API_KEY=
# Optional. GET and read-only MCP tools. Omit to use the master key for everything.
# BRIDGE_READ_KEY=
# Distinct from BRIDGE_API_KEY. Required only if clients use /authorize and /token.
# OAUTH_CLIENT_SECRET=
OAUTH_CLIENT_ID=second-brain
# Exact redirect URIs, comma-separated. /authorize returns 400 when this is empty.
# OAUTH_REDIRECT_URIS=http://127.0.0.1:6274/oauth/callback

PORT=3000
ENABLED_MODULES=brain
BRIDGE_URL=http://127.0.0.1:3000
DATABASE_URL=postgresql://brain:brain@127.0.0.1:5432/brain
# Set to true only when the database requires TLS. Leave unset for docker compose.
# DATABASE_SSL=true
# TRUST_PROXY=1

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-4o-mini

# Point this at a copy of examples/demo-vault, never at the committed folder.
OBSIDIAN_VAULT_PATH=
# BRAIN_WIKI_DIR_NAME=📒 Wiki
# WIKI_EXCLUDE_PREFIXES=
# WIKI_INCLUDE_PREFIXES=

# WIKI_SYNTHESIS_MODEL=gpt-5.6-luna
# WIKI_SYNTHESIS_BASE_URL=
# WIKI_SYNTHESIS_API_KEY=
# DEEPSEEK_API_KEY=
# WIKI_THINKING_STEPS=analysis
# WIKI_LLM_MAX_TOKENS=32768
# WIKI_MIN_FACT_RETENTION=0.9
# WIKI_ALERT_FACT_RETENTION=0.5

# Optional modules. Uncomment the credentials and add the name to ENABLED_MODULES.
# YNAB_API_TOKEN=
# YNAB_SAVINGS_EXCLUDE_GROUPS=
# YNAB_EARMARKED_GROUPS=
# YNAB_SAVINGS_MIN_INCOME=500
# WITHINGS_CLIENT_ID=
# WITHINGS_CLIENT_SECRET=
# WITHINGS_REDIRECT_URI=http://127.0.0.1:3000/withings/callback
# WITHINGS_SCOPE=metrics,activity
# BILLS_DOCS_PATH=
# JOB_DOCS_PATH=

# MONTHLY_BUDGET_ID=
# MONTHLY_TR_ACCOUNT_ID=
# MONTHLY_PORTFOLIO_DOC=
# MONTHLY_ANCHOR_DOCS=
# MONTHLY_REVIEW_DOC=
# MONTHLY_TOUCHED_DIRS=🚀 Personal,💼 Work
